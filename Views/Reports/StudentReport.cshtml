@model AttendenceManagementSystem.ViewModels.StudentDetailReportViewModel

@{
    ViewData["Title"] = "Student Report";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="content-card">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>
                <i class="bi bi-person-badge"></i> Individual Student Report
            </h2>
            <p class="text-muted mb-0">
                <strong>@Model.StudentName</strong> (@Model.RollNumber) | 
                @Model.SubjectCode - @Model.SubjectName
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportStudentReportPDF" asp-route-id="@Model.EnrollmentId" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")" class="btn btn-danger">
                <i class="bi bi-file-earmark-pdf"></i> Export PDF
            </a>
            <a asp-action="ExportStudentReport" asp-route-id="@Model.EnrollmentId" class="btn btn-success">
                <i class="bi bi-file-earmark-excel"></i> Export Excel
            </a>
            <a asp-action="CourseReport" asp-route-id="@Model.CourseOfferingId" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Course
            </a>
        </div>
    </div>

    <!-- Date Filter -->
    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white">
            <i class="bi bi-funnel"></i> Date Range Filter
        </div>
        <div class="card-body">
            <form id="filterForm" class="row g-3 align-items-end">
                <input type="hidden" name="id" value="@Model.EnrollmentId" />
                <div class="col-md-4">
                    <label for="startDate" class="form-label">From Date</label>
                    <input type="date" class="form-control" id="startDate" name="startDate" 
                           value="@Model.StartDate.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-4">
                    <label for="endDate" class="form-label">To Date</label>
                    <input type="date" class="form-control" id="endDate" name="endDate" 
                           value="@Model.EndDate.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-4">
                    <button type="submit" id="filterBtn" class="btn btn-primary me-2">
                        <span id="filterText">
                            <i class="bi bi-search"></i> Apply Filter
                        </span>
                        <span id="filterSpinner" class="d-none">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            Loading...
                        </span>
                    </button>
                    <button type="button" id="resetBtn" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </button>
                </div>
            </form>
            <div class="mt-2">
                <small class="text-muted">
                    <i class="bi bi-info-circle"></i> Showing records from 
                    <strong id="displayStartDate">@Model.StartDate.ToString("dd MMM yyyy")</strong> to 
                    <strong id="displayEndDate">@Model.EndDate.ToString("dd MMM yyyy")</strong>
                </small>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4" id="summaryCards">
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body text-center">
                    <h5 class="card-title">
                        <i class="bi bi-check-circle"></i> Present
                    </h5>
                    <h2 class="mb-0" id="presentCount">@Model.PresentCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger">
                <div class="card-body text-center">
                    <h5 class="card-title">
                        <i class="bi bi-x-circle"></i> Absent
                    </h5>
                    <h2 class="mb-0" id="absentCount">@Model.AbsentCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body text-center">
                    <h5 class="card-title">
                        <i class="bi bi-calendar-x"></i> Leave
                    </h5>
                    <h2 class="mb-0" id="leaveCount">@Model.LeaveCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body text-center">
                    <h5 class="card-title">
                        <i class="bi bi-percent"></i> Percentage
                    </h5>
                    <h2 class="mb-0">@Model.AttendancePercentage%</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Chart -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">
                <i class="bi bi-pie-chart-fill"></i> Attendance Status Distribution
            </h5>
            <div class="row">
                <div class="col-md-6 mx-auto">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
            <div class="alert alert-info mt-3 text-center">
                <strong>Total Classes:</strong> @Model.TotalClasses | 
                <strong>Attendance Rate:</strong> 
                @if (Model.AttendancePercentage >= 85)
                {
                    <span class="badge bg-success" style="font-size: 1.1rem;">Excellent (@Model.AttendancePercentage%)</span>
                }
                else if (Model.AttendancePercentage >= 70)
                {
                    <span class="badge bg-warning text-dark" style="font-size: 1.1rem;">Good (@Model.AttendancePercentage%)</span>
                }
                else
                {
                    <span class="badge bg-danger" style="font-size: 1.1rem;">Poor (@Model.AttendancePercentage%)</span>
                }
            </div>
        </div>
    </div>

    <!-- Detailed History Table -->
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">
                <i class="bi bi-calendar-range"></i> Date-wise Attendance History
            </h5>
            
            @if (Model.AttendanceHistory.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Date</th>
                                <th>Day</th>
                                <th>Time Slot</th>
                                <th class="text-center">Status</th>
                                <th>Marked At</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model.AttendanceHistory)
                            {
                                <tr>
                                    <td>
                                        <strong>@record.Date.ToString("MMM dd, yyyy")</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@record.DayOfWeek</span>
                                    </td>
                                    <td>
                                        <i class="bi bi-clock"></i> @record.TimeSlot
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-@record.StatusBadge" style="font-size: 0.95rem;">
                                            @record.Status
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted">@record.MarkedAt.ToString("hh:mm tt")</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i> No attendance records found yet.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    
    <script>
        // Serialize ViewModel data to JavaScript
        var chartData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartData));
        var enrollmentId = @Model.EnrollmentId;
        var statusChart;

        // Initialize Chart
        function initChart() {
            var ctx = document.getElementById('statusChart').getContext('2d');
            statusChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: chartData.labels,
                    datasets: [{
                        data: chartData.data,
                        backgroundColor: chartData.backgroundColors,
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: {
                                    size: 14
                                }
                            }
                        },
                        title: {
                            display: true,
                            text: 'Attendance Status Breakdown',
                            font: {
                                size: 16
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.label || '';
                                    let value = context.parsed || 0;
                                    let total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    let percentage = ((value / total) * 100).toFixed(1);
                                    return label + ': ' + value + ' (' + percentage + '%)';
                                }
                            }
                        }
                    }
                }
            });
        }

        // Initialize on page load
        initChart();

        // 🚀 AJAX Filter Handler (No Page Refresh!)
        $(document).ready(function() {
            const $filterForm = $('#filterForm');
            const $filterBtn = $('#filterBtn');
            const $filterText = $('#filterText');
            const $filterSpinner = $('#filterSpinner');
            const $resetBtn = $('#resetBtn');

            // Handle filter submit
            $filterForm.on('submit', async function(e) {
                e.preventDefault();

                const startDate = $('#startDate').val();
                const endDate = $('#endDate').val();

                // Client-side validation
                if (!startDate || !endDate) {
                    if (typeof showToast === 'function') {
                        showToast('Please select both start and end dates.', 'error');
                    }
                    return;
                }

                if (new Date(startDate) > new Date(endDate)) {
                    if (typeof showToast === 'function') {
                        showToast('Start date cannot be after end date.', 'error');
                    }
                    return;
                }

                // Show loading state
                $filterBtn.prop('disabled', true);
                $filterText.addClass('d-none');
                $filterSpinner.removeClass('d-none');
                $('#summaryCards').css('opacity', '0.5');

                try {
                    // Fetch filtered data using fetchWithAuth
                    const url = `/api/ReportsApi/student/${enrollmentId}?startDate=${startDate}&endDate=${endDate}`;
                    const response = await fetchWithAuth(url, { method: 'GET' });

                    if (response.ok) {
                        const result = await response.json();

                        // Update summary cards
                        $('#presentCount').text(result.data.presentCount);
                        $('#absentCount').text(result.data.absentCount);
                        $('#leaveCount').text(result.data.leaveCount);

                        // Update date display
                        const startDateObj = new Date(startDate);
                        const endDateObj = new Date(endDate);
                        $('#displayStartDate').text(startDateObj.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }));
                        $('#displayEndDate').text(endDateObj.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }));

                        // Update chart
                        chartData = result.data.chartData;
                        statusChart.data.labels = chartData.labels;
                        statusChart.data.datasets[0].data = chartData.data;
                        statusChart.data.datasets[0].backgroundColor = chartData.backgroundColors;
                        statusChart.update();

                        // Reload page to update table (full implementation would update table via DOM)
                        if (typeof showToast === 'function') {
                            showToast('Report filtered successfully!', 'success');
                        }
                        
                        // For now, reload with new parameters (better UX than before)
                        setTimeout(() => {
                            window.location.href = `/Reports/StudentReport?id=${enrollmentId}&startDate=${startDate}&endDate=${endDate}`;
                        }, 800);

                    } else {
                        const error = await response.json();
                        if (typeof showToast === 'function') {
                            showToast(error.message || 'Failed to filter report.', 'error');
                        }
                    }
                } catch (error) {
                    console.error('Filter error:', error);
                    if (typeof showToast === 'function') {
                        showToast('Network error. Please try again.', 'error');
                    }
                } finally {
                    // Reset loading state
                    $filterBtn.prop('disabled', false);
                    $filterText.removeClass('d-none');
                    $filterSpinner.addClass('d-none');
                    $('#summaryCards').css('opacity', '1');
                }
            });

            // Handle reset button
            $resetBtn.on('click', function() {
                window.location.href = `/Reports/StudentReport?id=${enrollmentId}`;
            });
        });
    </script>
}
